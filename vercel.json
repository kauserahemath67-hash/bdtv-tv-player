{
  "cleanUrls": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/_index"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/playlist\\.m3u$",
      "dest": "/api/playlist"
    },
    {
      "src": "^/version\\.json$",
      "dest": "/api/version"
    },
    {
      "src": "^/api/channels(.*)$",
      "dest": "/api/channels$1"
    },
    {
      "src": "^/api/auth(.*)$",
      "dest": "/api/auth$1"
    },
    {
      "src": "^/api/health(.*)$",
      "dest": "/api/health$1"
    },
    {
      "src": "^/api/customers(.*)$",
      "dest": "/api/customers$1"
    },
    {
      "src": "^/api/devices(.*)$",
      "dest": "/api/devices$1"
    },
    {
      "src": "^/api/subscriptions(.*)$",
      "dest": "/api/subscriptions$1"
    },
    {
      "src": "^/api/settings(.*)$",
      "dest": "/api/settings$1"
    },
    {
      "src": "^/api/version(.*)$",
      "dest": "/api/version$1"
    },
    {
      "src": "^/api/report(.*)$",
      "dest": "/api/report$1"
    },
    {
      "src": "^/(css|js)/(.+)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.+)$",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Device-Fingerprint" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/health?auto_scan=1",
      "schedule": "0 0 * * *"
    }
  ]
}
