{
  "cleanUrls": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/playlist\\.m3u$",
      "dest": "/api/playlist"
    },
    {
      "src": "^/version\\.json$",
      "dest": "/api/version"
    },
    {
      "src": "^/api/(.+)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/(css|js)/(.+)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.+\\.(html|css|js|json|png|jpg|ico|svg))$",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Device-Fingerprint" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/health?auto_scan=1",
      "schedule": "0 0 * * *"
    }
  ]
}
