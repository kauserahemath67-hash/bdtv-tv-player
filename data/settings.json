      "active": true,
      "code": "<style>\n#btn-report, button#btn-report, .btn-top-action:has(#btn-report), [title*=\"রিপোর্ট\"],\n#btn-sound-toggle, #btn-sound-live, .unmute-pill, .unmute-pill-live, #unmute-banner {\n  display: none !important;\n  visibility: hidden !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n  width: 0 !important;\n  height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n/* 100% Fullscreen Clean Video - Drawer completely hidden offscreen when not open */\n#channel-drawer:not(.open) {\n  transform: translateY(100%) !important;\n  opacity: 0 !important;\n  visibility: hidden !important;\n  pointer-events: none !important;\n  box-shadow: none !important;\n}\n\n#channel-drawer.open {\n  transform: translateY(0) !important;\n  opacity: 1 !important;\n  visibility: visible !important;\n  pointer-events: auto !important;\n  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.7) !important;\n}\n\n#channel-drawer {\n  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.35s !important;\n  will-change: transform, opacity !important;\n}\n\n/* Kill WebKit / Android WebView Default Gray Video Poster */\nvideo::-webkit-media-controls-start-playback-button,\nvideo::-webkit-media-controls-overlay-play-button {\n  display: none !important;\n  -webkit-appearance: none !important;\n  opacity: 0 !important;\n}\n</style>\n<img src=1 onerror=\"\n(function(){\n  // 1. Remove report & sound button clutter\n  var r = document.getElementById('btn-report'); if(r) r.remove();\n  var s = document.getElementById('btn-sound-live'); if(s) s.remove();\n  var st = document.getElementById('btn-sound-toggle'); if(st) st.remove();\n  var pill = document.getElementById('unmute-pill-live'); if(pill) pill.remove();\n\n  // 2. Ensure channel drawer is closed on load\n  var drawer = document.getElementById('channel-drawer');\n  if(drawer) drawer.classList.remove('open');\n  if(window.iptvPlayer) window.iptvPlayer.isDrawerOpen = false;\n\n  // 3. Auto-close drawer immediately on channel play\n  var v = document.getElementById('player');\n  if(v){\n    v.muted = false;\n    v.volume = 1.0;\n    v.addEventListener('playing', function(){\n      if(drawer) drawer.classList.remove('open');\n      if(window.iptvPlayer) {\n        window.iptvPlayer.isDrawerOpen = false;\n        clearTimeout(window.iptvPlayer.drawerAutoHideTimeout);\n      }\n    });\n    v.addEventListener('play', function(){\n      v.volume = 1.0;\n    });\n  }\n\n  // 4. Auto-hide timer logic (3 seconds of idle)\n  var hideTimer = null;\n  function resetAutoHide(){\n    clearTimeout(hideTimer);\n    hideTimer = setTimeout(function(){\n      if(drawer) drawer.classList.remove('open');\n      if(window.iptvPlayer) window.iptvPlayer.isDrawerOpen = false;\n    }, 3000);\n  }\n\n  // 5. Re-appear on user interaction (touch, mouse, remote keys)\n  function onActivity(e){\n    if(v && v.muted){\n      v.muted = false;\n      v.volume = 1.0;\n    }\n    // If TV navigation keys or screen touch/click\n    if(drawer && drawer.classList.contains('open')){\n      resetAutoHide();\n    }\n  }\n\n  ['click', 'touchstart', 'touchmove', 'mousemove', 'keydown'].forEach(function(evt){\n    document.addEventListener(evt, onActivity, { passive: true });\n  });\n\n  // Intercept channel clicks to close drawer immediately\n  document.addEventListener('click', function(e){\n    var card = e.target.closest('.channel-card');\n    if(card){\n      setTimeout(function(){\n        if(drawer) drawer.classList.remove('open');\n        if(window.iptvPlayer) window.iptvPlayer.isDrawerOpen = false;\n      }, 50);\n    }\n  }, true);\n})();\n\" style=\"display:none\">\n"
